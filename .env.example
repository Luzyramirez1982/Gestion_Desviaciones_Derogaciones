# Copie este archivo como .env (no se sube a git) y complete los dos valores para conectar la aplicación a Supabase.
# Si no están definidos, la aplicación arranca en MODO DEMOSTRACIÓN con datos de ejemplo.
#
# Solo van la URL del proyecto y la clave PÚBLICA (publishable / anon).
# La clave service_role JAMÁS se pone aquí: solo vive como secreto en el servidor y en GitHub Actions.
VITE_SUPABASE_URL=https://<identificador-del-proyecto>.supabase.co
VITE_SUPABASE_KEY=<clave-publica-publishable>
